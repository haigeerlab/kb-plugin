{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "ROOT=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\"; [ -n \"$ROOT\" ] && [ -f \"$ROOT/scripts/kb.py\" ] && python3 -B \"$ROOT/scripts/kb.py\" capture hook >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
